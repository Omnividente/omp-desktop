{
  "version": 2,
  "project": "omp-desktop",
  "description": "Autonomous self-improvement loop for the OMP Desktop (Tauri + React/TS) app. Runs in parallel to normal development and never performs releases.",
  "default_branch": "main",
  "parallel_mode": {
    "enabled": true,
    "integration_branch": "autonomous/lab",
    "merge_target": "autonomous/lab",
    "never_merge_to_default": true
  },
  "release_policy": {
    "automation": "disabled",
    "human_gated": true,
    "notes": "The loop must never bump versions, create tags/GitHub Releases, publish artifacts, or edit release/updater workflows. A human operator reviews the integration branch and decides releases."
  },
  "product": {
    "roots": [
      "src",
      "src-tauri/src",
      "src-tauri/tests"
    ],
    "editable_globs": [
      "src/**",
      "src-tauri/src/**",
      "src-tauri/tests/**"
    ],
    "excluded": [
      ".git/",
      ".github/workflows/**",
      ".github/scripts/**",
      ".github/release-notes/**",
      ".github/release-tag-exceptions.json",
      "scripts/autonomous/**",
      "docs/autonomous/**",
      "autonomous-project.json",
      "agent_tasks.json",
      "package.json",
      "package-lock.json",
      "src-tauri/Cargo.toml",
      "src-tauri/Cargo.lock",
      "src-tauri/tauri.conf.json",
      "src-tauri/tauri.updater-e2e.conf.json",
      "**/*.png",
      "**/*.ico",
      "**/*.icns"
    ],
    "manual_review_paths": [
      "src/clientUpdater.ts",
      "src/useClientUpdater.ts",
      "src/useClientUpdater.test.tsx",
      "src/ClientUpdateNotice.tsx",
      "src/UpdateNotice.tsx",
      "src/UpdateNotices.test.tsx",
      "src/updateReminder.ts",
      "src/updateReminder.test.ts",
      "src-tauri/src/updater*",
      "src-tauri/tests/updater*"
    ],
    "manual_review_notes": "The auto-update surface is ordinary product code, so the loop may propose fixes there, but a broken updater cannot be repaired remotely. Any pull request touching these paths is downgraded to manual review and never merged unattended."
  },
  "merge_gate": {
    "require_regression_test": true,
    "evidence_check_name": "Autonomous Evidence Gate",
    "manual_approval_labels": [
      "approved-by-owner"
    ],
    "test_globs": [
      "*.test.ts",
      "*.test.tsx",
      "*.spec.ts",
      "*.spec.tsx",
      "src-tauri/tests/**"
    ],
    "notes": "A pull request may only merge when every required_check_names check run and the evidence_check_name check run are green for the exact revision being merged. manual_approval_labels are a signal for humans, not an approval: only a review approval recorded against that revision by an owner_approvers login can release a manual-review pull request, because a label survives a force-push. A diff larger than max_changed_files, or one whose file list cannot be proven complete, is never merged unattended.",
    "required_check_names": [
      "Checks (ubuntu-latest)",
      "Checks (windows-latest)"
    ],
    "owner_approvers": [
      "Omnividente"
    ],
    "max_changed_files": 200
  },
  "validation": {
    "gate_workflow": ".github/workflows/pr.yml",
    "commands": [
      {
        "name": "install",
        "cmd": [
          "npm",
          "ci"
        ],
        "timeout_seconds": 600,
        "required": true
      },
      {
        "name": "typecheck",
        "cmd": [
          "npm",
          "run",
          "typecheck"
        ],
        "timeout_seconds": 300,
        "required": true
      },
      {
        "name": "lint",
        "cmd": [
          "npm",
          "run",
          "lint"
        ],
        "timeout_seconds": 300,
        "required": true
      },
      {
        "name": "test",
        "cmd": [
          "npm",
          "test"
        ],
        "timeout_seconds": 600,
        "required": true
      },
      {
        "name": "build",
        "cmd": [
          "npm",
          "run",
          "build"
        ],
        "timeout_seconds": 600,
        "required": true
      }
    ],
    "total_timeout_seconds": 2400
  },
  "anti_churn": {
    "require_evidence": true,
    "one_task_per_defect_class": true,
    "ban_repeat_without_new_evidence": true,
    "require_regression_test_for_bugfix": true,
    "min_todo_tasks": 3
  },
  "automation": {
    "ai_worker": "jules",
    "allowed_pr_authors": [
      "google-labs-jules[bot]"
    ],
    "max_open_pull_requests": 1,
    "blocking_labels": [
      "hold",
      "do-not-merge",
      "human-review",
      "wip"
    ]
  },
  "task_focus": [
    "quality",
    "tests",
    "bugfix",
    "refactor",
    "a11y",
    "i18n",
    "perf",
    "compat"
  ],
  "risk_ceiling": "medium"
}
