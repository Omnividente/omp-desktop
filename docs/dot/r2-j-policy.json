{
  "schema": 1,
  "kind": "dot-r2-j-policy",
  "repository": "Omnividente/omp-desktop",
  "control_issue": "https://github.com/Omnividente/omp-desktop/issues/146",
  "identity_mode": "shared-github-procedural",
  "activation": "separate-owner-acceptance-and-hashed-grant",
  "maintenance_state": {"branch": "dot/r2-j-state", "path": "dot-state.json", "cas": "expected-file-blob-sha", "automatic_lease_takeover": false},
  "source_prefixes": ["scripts/autonomous/", "docs/autonomous/"],
  "protected_paths": [
    "scripts/autonomous/dot_authority.py",
    "scripts/autonomous/dot_authority_test.py"
  ],
  "limits": {"active_tasks": 1, "active_drafts": 1, "files": 10, "lines": 1000, "ci_revisions": 3},
  "schedule_minutes": 60,
  "branch_prefix": "dot/jules-",
  "base_branch": "main",
  "allowed_actions": ["develop", "test", "commit", "draft_create", "draft_update", "checkpoint"],
  "protected_operations": [
    "change_workflows", "change_live_queue_or_state", "issue_execution_authority",
    "change_grant_or_revocation", "change_credentials_or_settings", "manual_actions",
    "ready_for_review", "approve", "merge", "auto_merge", "bypass", "release", "install"
  ],
  "critical_source_terms": [
    "admission", "provenance", "journal", "state_store", "dispatch", "recovery", "owner_", "verify_policy"
  ]
}
