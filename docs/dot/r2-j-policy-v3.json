{
  "schema": 2,
  "version": 3,
  "kind": "dot-r2-j-policy",
  "repository": "Omnividente/omp-desktop",
  "control_issue": "https://github.com/Omnividente/omp-desktop/issues/146",
  "identity_mode": "shared-github-procedural",
  "activation": "separate-owner-acceptance-new-versioned-grant",
  "maintenance_state": {
    "branch": "dot/r2-j-state",
    "path": "dot-state.json",
    "cas": "expected-file-blob-sha",
    "automatic_lease_takeover": false
  },
  "source_prefixes": [
    "scripts/autonomous/",
    "docs/autonomous/"
  ],
  "protected_paths": [
    "scripts/autonomous/dot_authority.py",
    "scripts/autonomous/dot_authority_test.py",
    "scripts/autonomous/dot_merge.py",
    "scripts/autonomous/dot_merge_test.py",
    "scripts/autonomous/dot_state.py",
    "scripts/autonomous/dot_state_test.py"
  ],
  "limits": {
    "active_tasks": 1,
    "active_prs": 1,
    "files": 10,
    "lines": 1000,
    "ci_revisions": 3
  },
  "schedule_minutes": 60,
  "branch_prefix": "dot/jules-",
  "base_branch": "main",
  "allowed_actions": [
    "develop",
    "test",
    "commit",
    "draft_create",
    "draft_update",
    "checkpoint",
    "request_review",
    "ready_for_review",
    "squash_merge"
  ],
  "protected_operations": [
    "change_workflows",
    "change_live_queue_or_state",
    "issue_execution_authority",
    "change_grant_or_revocation",
    "change_credentials_or_settings",
    "manual_actions",
    "approve",
    "merge",
    "auto_merge",
    "bypass",
    "release",
    "install"
  ],
  "critical_source_terms": [
    "admission",
    "provenance",
    "journal",
    "state_store",
    "dispatch",
    "recovery",
    "owner_",
    "verify_policy",
    "lab_controller",
    "lifecycle"
  ],
  "review": {
    "ordinary_executions": [
      "code-review",
      "safety-review"
    ],
    "critical_executions": [
      "code-review",
      "safety-review"
    ],
    "origin": "native-agent-tool-result",
    "permissions": "read-only-task-scope",
    "production_python_is_critical": true,
    "changed_or_removed_tests_are_critical": true,
    "author_context_is_independent": false,
    "unverifiable_evidence": "block-merge-and-notify-exception",
    "independence": "procedural-not-provider-attested"
  },
  "integration": {
    "method": "squash",
    "expected_head_required": true,
    "strict_required_checks": true,
    "workflows": {
      ".github/workflows/pr.yml": [
        "Checks (ubuntu-latest)",
        "Checks (windows-latest)"
      ],
      ".github/workflows/autonomous_control_ci.yml": [
        "Validate the autonomous control plane"
      ],
      ".github/workflows/codeql.yml": [
        "Analyze (javascript-typescript)",
        "Analyze (rust)"
      ]
    },
    "unknown_outcome": "get-only-no-resend",
    "post_merge": "verify-commit-parent-tree-main-installed-files-push-ci-before-retirement"
  }
}
